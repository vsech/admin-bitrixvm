BITRIXVM_PUBLIC_HOST=localhost
BITRIXVM_DATABASE_URL=postgresql+asyncpg://bitrixvm:{PASSWORD}@postgres:5432/bitrixvm
BITRIXVM_DATABASE_PASSWORD_FILE=/run/secrets/postgres_password
BITRIXVM_ACCESS_TOKEN_MINUTES=15
BITRIXVM_REFRESH_TOKEN_DAYS=14
BITRIXVM_CONFIRMATION_MINUTES=5
BITRIXVM_SSH_CONNECT_TIMEOUT=10
BITRIXVM_SSH_COMMAND_TIMEOUT=120
BITRIXVM_WORKER_POLL_SECONDS=1
BITRIXVM_MASTER_KEY_FILE=/run/secrets/master_key
BITRIXVM_JWT_SECRET_FILE=/run/secrets/jwt_secret
